---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page not found" description="This address doesn't lead to a page on TimeAtlas. Find your way back to world clocks." noindex>
  <section class="not-found-shell" aria-labelledby="not-found-title">
    <div class="not-found-art" aria-hidden="true">
      <svg width="148" height="148" viewBox="0 0 148 148" fill="none"><circle cx="74" cy="74" r="62" stroke="currentColor" stroke-width="1" opacity=".2"/><circle cx="74" cy="74" r="47" stroke="currentColor" stroke-width="1.5"/><ellipse cx="74" cy="74" rx="22" ry="47" stroke="currentColor" opacity=".55"/><path d="M27 74h94M35 49h78M35 99h78" stroke="currentColor" opacity=".55"/><circle cx="113" cy="42" r="7" fill="currentColor"/><path d="m108 37 10 10m0-10-10 10" stroke="var(--color-navy-900)" stroke-width="1.5"/></svg>
    </div>
    <p class="not-found-kicker">404 · OFF THE MAP</p>
    <h1 id="not-found-title">A little lost?<br /><span>Let’s get you back.</span></h1>
    <p class="not-found-description">This address doesn’t lead to a page on TimeAtlas. The link may have changed, or there may be a typo in the URL.</p>
    <div class="not-found-actions"><a class="not-found-primary" href="/">Back to home <span aria-hidden="true">↗</span></a><a class="not-found-secondary" href="/clocks/">Explore world clocks <span aria-hidden="true">→</span></a></div>
    <a class="not-found-guide" href="/guide/">Looking for help? Read the time zone guide.</a>
  </section>
</Layout>
