---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="This page doesn't exist on TimeAtlas." noindex>
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-20 text-center sm:px-6">
    <p class="text-sm font-medium uppercase tracking-wide text-cyan-400">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-paper-100">
      We couldn't find that page
    </h1>
    <p class="mt-3 text-paper-400">
      The link might be out of date, or the page may have moved. Here's where you can go
      instead:
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-md border border-cyan-600/50 bg-cyan-600/10 px-4 py-2 text-sm font-medium text-cyan-400 hover:bg-cyan-600/20"
      >
        Go to the homepage
      </a>
      <a
        href="/clocks"
        class="rounded-md border border-navy-600 px-4 py-2 text-sm text-paper-200 hover:text-paper-100"
      >
        Browse world clocks
      </a>
      <a
        href="/guide"
        class="rounded-md border border-navy-600 px-4 py-2 text-sm text-paper-200 hover:text-paper-100"
      >
        Read the time zone guide
      </a>
    </div>
  </div>
</Layout>
