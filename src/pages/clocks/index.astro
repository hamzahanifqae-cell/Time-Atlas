---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import WorldClocksBrowser from "../../components/clocks/WorldClocksBrowser.tsx";
import { placePath, placeTitle, places } from "../../lib/seo/places";
---

<Layout
  title="World Clocks by Country"
  description="Current local time by country and city. Browse a world clock for every place TimeAtlas covers, with UTC offsets and daylight saving, without the 3D globe."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "World clocks", href: "/clocks/" }]} />
    <h1 class="text-3xl font-semibold tracking-tight text-paper-100">World clocks by country</h1>
    <p class="mt-2 max-w-2xl text-paper-400">
      Search a city or country in the list below. The card shows that place's local time, its
      UTC offset, and whether daylight saving applies on today's date. Countries with more than
      one time zone list each zone separately. To see every clock on a chosen date, set the UTC
      date in <a href="/#explorer-heading" class="underline hover:text-paper-100">Time explorer</a>
      on the homepage, or read
      <a href="/time-difference/" class="underline hover:text-paper-100">how the time difference works</a>.
      Offsets come from the IANA zone, as explained in the
      <a href="/guide/#utc" class="underline hover:text-paper-100">UTC and offsets</a> section of the guide.
    </p>
    <p class="mt-3 max-w-2xl text-paper-400">
      These city pages explain the zone, the offset through the year, and an example meeting time:
      {
        places.map((place, index) => (
          <>
            {index > 0 && (index === places.length - 1 ? ", and " : ", ")}
            <a href={placePath(place)} class="underline hover:text-paper-100">{placeTitle(place)}</a>
          </>
        ))
      }
      .
    </p>
    <div class="mt-6">
      <WorldClocksBrowser client:load />
    </div>
  </div>
</Layout>
