---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import WorldClocksBrowser from "../../components/clocks/WorldClocksBrowser.tsx";
import { placePath, placeTitle, places } from "../../lib/seo/places";
import cities from "../../../public/data/cities.json";
import countries from "../../../public/data/countries.json";

// Build-time summary of the same files the interactive index fetches, so the page has useful
// content before (or without) that client-side load.
const numberFormat = new Intl.NumberFormat("en-US");
const cityCount = numberFormat.format(cities.length);
const countryCount = numberFormat.format(countries.length);
const multiZoneCountries = countries
  .filter((country) => country.multiZone && country.cityCount > 0)
  .sort((a, b) => b.timezones.length - a.timezones.length || a.name.localeCompare(b.name));
---

<Layout
  title="World Clocks by Country"
  description="Current local time by country and city. Browse a world clock for every place TimeAtlas covers, with UTC offsets and daylight saving, without the 3D globe."
>
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "World clocks", href: "/clocks/" }]} />
    <h1 class="text-3xl font-semibold tracking-tight text-paper-100">World clocks by country</h1>
    <p class="mt-2 max-w-2xl text-paper-400">
      Search a city or country in the list below. The card shows that place's local time, its
      UTC offset, and whether daylight saving applies on today's date. Countries with more than
      one time zone list each zone separately. To see every clock on a chosen date, set the UTC
      date in <a href="/#explorer-heading" class="underline hover:text-paper-100">Time explorer</a>
      on the homepage, or read
      <a href="/time-difference/" class="underline hover:text-paper-100">how the time difference works</a>.
      Offsets come from the IANA zone, as explained in the
      <a href="/guide/#utc" class="underline hover:text-paper-100">UTC and offsets</a> section of the guide.
    </p>
    <p class="mt-3 max-w-2xl text-paper-400">
      These city pages explain the zone, the offset through the year, and an example meeting time:
      {
        places.map((place, index) => (
          <>
            {index > 0 && (index === places.length - 1 ? ", and " : ", ")}
            <a href={placePath(place)} class="underline hover:text-paper-100">{placeTitle(place)}</a>
          </>
        ))
      }
      .
    </p>
    <section class="mt-6 max-w-2xl rounded-2xl border border-navy-700 bg-navy-800/40 p-5">
      <h2 class="text-lg font-semibold text-paper-100">What this index covers</h2>
      <p class="mt-2 text-sm text-paper-300">
        The index covers {countryCount} countries and territories and {cityCount} cities. The
        <a href="/guide/#coverage" class="underline hover:text-paper-100">coverage notes</a>
        explain which cities are included. {multiZoneCountries.length} countries with cities in
        the index use more than one IANA time zone. Some share an offset and some do not, so pick the
        city rather than the country:
      </p>
      <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm text-paper-400">
        {
          multiZoneCountries.map((country) => (
            <li>
              {country.name} <span class="text-paper-600">({country.timezones.length} zones)</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-sm text-paper-300">
        For one place, search the <a href="/" class="underline hover:text-paper-100">world clock</a>
        on the homepage, which also shows the time zone map. The
        <a href="/guide/" class="underline hover:text-paper-100">time zone guide</a> explains UTC
        offsets and daylight saving, and
        <a href="/time/" class="underline hover:text-paper-100">time in major cities</a> collects
        the city pages listed above.
      </p>
    </section>
    <div class="mt-6">
      <WorldClocksBrowser client:load />
    </div>
  </div>
</Layout>
