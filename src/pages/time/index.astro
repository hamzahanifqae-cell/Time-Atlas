---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import { siteOrigin } from "../../config/site";
import { placeDescription, placePath, placeTitle, places } from "../../lib/seo/places";

const title = "Time in Major Cities";
const description =
  "Time zones for a few cities with different rules: daylight saving, a half-hour offset, or a name shared with another place. Search any other city on the world clock.";
const canonical = new URL("/time/", siteOrigin).toString();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical,
};
---

<Layout title={title} description={description} structuredData={structuredData}>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Time in major cities", href: "/time/" }]} />
    <h1 class="text-3xl font-semibold tracking-tight text-paper-100">Time in major cities</h1>
    <p class="mt-3 text-paper-400">
      These pages explain the IANA time zone for a city, including daylight saving and places that
      share a name. They do not print a live clock. A frozen "current time" in the page would be
      wrong within a minute. Search the city on the
      <a href="/" class="underline hover:text-paper-100">world clock</a>
      for the time on your device's clock.
    </p>
    <p class="mt-3 text-paper-300">
      TimeAtlas does not publish a page for every city, and it does not publish a page for every
      pair of cities. Delhi uses the same zone as Mumbai. A second page would repeat the same
      rules. For a meeting across cities, use
      <a href="/time-difference/" class="underline hover:text-paper-100">the time difference between cities</a>.
      For who changes clocks at all, see
      <a href="/daylight-saving/" class="underline hover:text-paper-100">countries that don't observe daylight saving time</a>.
    </p>

    <ul class="mt-8 space-y-5">
      {
        places.map((place) => (
          <li>
            <h2 class="text-xl font-semibold text-paper-100">
              <a href={placePath(place)} class="underline decoration-navy-600 underline-offset-2 hover:text-paper-100">
                {placeTitle(place)}
              </a>
            </h2>
            <p class="mt-1 text-paper-300">{placeDescription(place)}</p>
          </li>
        ))
      }
    </ul>
  </article>
</Layout>
