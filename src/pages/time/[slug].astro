---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import { siteOrigin } from "../../config/site";
import { placeDescription, placeHeading, placePath, placeTitle, places, type Place } from "../../lib/seo/places";
import { exampleBusinessHours, gapSentence, offsetLabel, SAMPLE_DATES } from "../../lib/seo/zoneSamples";

export function getStaticPaths() {
  return places.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}

interface Props {
  place: Place;
}

const { place } = Astro.props;
const title = placeTitle(place);
const heading = placeHeading(place);
const description = placeDescription(place);
const canonical = new URL(placePath(place), siteOrigin).toString();
const samples = SAMPLE_DATES.map((date) => ({
  label: date.label,
  offset: offsetLabel(place.zone, date.ms),
}));
const meetingExamples = place.comparisons.map((partner) => ({
  partner,
  examples: [
    exampleBusinessHours(place.zone, partner.zone, 2026, 1, 15),
    exampleBusinessHours(place.zone, partner.zone, 2026, 7, 15),
  ],
}));
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonical,
    },
    {
      "@type": "FAQPage",
      mainEntity: place.faqs.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<Layout title={title} description={description} structuredData={structuredData}>
  <article class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs
      items={[
        { label: "Home", href: "/" },
        { label: "Time in major cities", href: "/time/" },
        { label: place.regionLabel, href: placePath(place) },
      ]}
    />
    <h1 class="text-3xl font-semibold tracking-tight text-paper-100">{heading}</h1>
    <p class="mt-3 text-paper-400">{place.notTheSameAs} The IANA zone is <code class="tabular">{place.zone}</code>.</p>
    <p class="mt-3 text-paper-300">{place.explanation}</p>
    {
      place.currentTimeNote && (
        <p class="mt-3 text-paper-300">
          {place.currentTimeNote}{" "}
          <a href="/" class="underline hover:text-paper-100">Open the world clock</a>.
        </p>
      )
    }

    <section class="mt-8">
      <h2 class="text-xl font-semibold text-paper-100">Offset on three dates</h2>
      <p class="mt-2 text-paper-300">
        Each row is the UTC offset at 12:00 UTC on that date, from IANA rules for {place.zone}. These
        are examples, not the live time. Around a clock change the offset can switch at 1:00 or 2:00
        local time, so the date alone is not always enough.
      </p>
      <table class="mt-4 w-full text-left text-sm text-paper-300">
        <caption class="sr-only">UTC offset for {place.regionLabel} on three sample dates in 2026</caption>
        <thead>
          <tr class="border-b border-navy-700 text-paper-400">
            <th scope="col" class="py-2 pr-4 font-medium">Date</th>
            <th scope="col" class="py-2 font-medium">Offset</th>
          </tr>
        </thead>
        <tbody>
          {
            samples.map((sample) => (
              <tr class="border-b border-navy-800">
                <th scope="row" class="py-2 pr-4 font-medium text-paper-100">{sample.label}</th>
                <td class="py-2 tabular">{sample.offset}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    {
      meetingExamples.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xl font-semibold text-paper-100">Example meeting time</h2>
          <p class="mt-2 text-paper-300">
            These are example business hours, not a company's real opening time. Each line is 09:00 in {place.zone}, converted with IANA rules for that date.
          </p>
          {
            meetingExamples.map(({ partner, examples }) => (
              <div class="mt-4">
                <h3 class="text-base font-semibold text-paper-100">
                  {partner.href ? (
                    <a href={partner.href} class="underline decoration-navy-600 underline-offset-2 hover:text-paper-100">
                      {place.name} and {partner.name}
                    </a>
                  ) : (
                    <span>{place.name} and {partner.name}</span>
                  )}
                </h3>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-paper-300">
                  {examples.map((example) => (
                    <li>
                      {`${example.localLabel} in ${place.name} is ${example.otherLabel} in ${partner.name}.${example.dateChanged ? " Those are different calendar dates." : " Those are the same calendar date."}`}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </section>
      )
    }

    <section class="mt-8">
      <h2 class="text-xl font-semibold text-paper-100">Gap with another place</h2>
      <ul class="mt-3 space-y-4">
        {
          place.comparisons.map((other) => (
            <li>
              <h3 class="text-base font-semibold text-paper-100">
                {other.href ? (
                  <a href={other.href} class="underline decoration-navy-600 underline-offset-2 hover:text-paper-100">
                    {place.name} and {other.name}
                  </a>
                ) : (
                  <span>
                    {place.name} and {other.name}
                  </span>
                )}
              </h3>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-paper-300">
                {SAMPLE_DATES.map((date) => (
                  <li>{`On ${date.label}, ${gapSentence(other.name, place.name, place.zone, other.zone, date.ms)}.`}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-paper-300">
        More than one city, including the weeks when the gap changes, is covered on the
        <a href="/time-difference/" class="underline hover:text-paper-100">time difference</a>
        page. Countries that stay on one offset are listed under
        <a href="/daylight-saving/" class="underline hover:text-paper-100">daylight saving time</a>.
      </p>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold text-paper-100">Current time</h2>
      <p class="mt-2 text-paper-300">
        Search {place.name} on the <a href="/" class="underline hover:text-paper-100">world clock</a>.
        The clock uses your device's time and {place.zone}, so daylight saving follows the rule in
        effect on that date. You can also
        <a href="/clocks/" class="underline hover:text-paper-100">browse world clocks by country</a>.
        Saved comparison cities stay in this browser. They are not separate addresses, and this page
        does not put a minute-by-minute time in the title.
      </p>
    </section>

    <section class="mt-8">
      <h2 class="text-xl font-semibold text-paper-100">Questions</h2>
      <dl class="mt-4 space-y-5">
        {
          place.faqs.map((item) => (
            <div>
              <dt class="font-semibold text-paper-100">{item.question}</dt>
              <dd class="mt-1 text-paper-300">{item.answer}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </article>
</Layout>
