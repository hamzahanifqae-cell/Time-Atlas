---
interface Props {
  /** Compact footer control, or the fuller control on the privacy page. */
  variant?: "footer" | "page";
}

const { variant = "page" } = Astro.props;
const buttonClass =
  variant === "footer"
    ? "text-left text-sm text-paper-400 underline hover:text-paper-100"
    : "rounded-md border border-cyan-600/50 bg-cyan-600/10 px-3 py-1.5 text-sm font-medium text-cyan-400 hover:bg-cyan-600/20";
---

<div class="mt-3">
  <button type="button" class={buttonClass} data-privacy-choices>
    {variant === "footer" ? "Privacy choices" : "Manage ad privacy choices"}
  </button>
  <p class="mt-2 text-sm text-paper-300" data-privacy-choices-status hidden role="status"></p>
</div>

<script is:inline>
  document.querySelectorAll("[data-privacy-choices]").forEach((button) => {
    if (button.dataset.bound === "true") return;
    button.dataset.bound = "true";
    button.addEventListener("click", () => {
      const status = button.parentElement?.querySelector("[data-privacy-choices-status]");
      const api = window.googlefc;
      if (api && typeof api.showRevocationMessage === "function") {
        api.showRevocationMessage();
        if (status) status.hidden = true;
        return;
      }
      if (status) {
        status.hidden = false;
        status.textContent =
          "Google's consent choices are not available in this browser. That happens when the European regulations message has not been published, when this visit is outside the regions that message covers, or when the consent script did not load. You can still manage Google ads at https://myadcenter.google.com/.";
      }
    });
  });
</script>
