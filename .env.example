# Copy this file to .env and fill in real values before a public production build.
# See /RELEASE_CHECKLIST.md and /DEPLOYMENT.md for details.
#
# All of these are build-time values baked into the static site at build time (Astro static
# output) — none of them are secrets, and none are required for local development
# (`npm run dev` and `npm run build:local` work with no .env file at all).

# The production origin this site will be served from. Must be a bare https:// URL with no
# path, query, fragment, or embedded credentials — e.g. https://timeatlas.example
# Required for `npm run build` (standard production build). Not required for build:local.
PUBLIC_SITE_ORIGIN=

# The real name of the person or organization operating this deployment. Shown on /about and
# /privacy. Required for `npm run build`.
PUBLIC_OPERATOR_NAME=

# A real, monitored contact address. Shown on /contact and /privacy. Required for
# `npm run build`. Only syntax is validated here — this does not confirm the address can
# actually receive mail.
PUBLIC_CONTACT_EMAIL=

# Set to "true" to add a global noindex directive and a staging banner, for deploying to a
# preview/staging URL you don't want search engines (or casual visitors) to treat as the real
# site. Leave unset ("false") for the real public launch. Note: noindex is not a security
# control — it does not password-protect the staging deployment.
PUBLIC_STAGING=false
